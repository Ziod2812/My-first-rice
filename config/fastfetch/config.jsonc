{
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 3,
      "right": 6
    },
    "color": {
      "1": "magenta",
      "2": "blue",
      "3": "cyan",
      "4": "white",
      "5": "bright_magenta",
      "6": "bright_blue"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "type": "string",
      "width": 9
    },
    "color": {
      "keys": "bright_magenta",
      "title": "bright_cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{1}@{2}"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "os",
      "key": "System",
      "keyColor": "bright_magenta"
    },
    {
      "type": "wm",
      "key": "Desktop",
      "keyColor": "bright_blue"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "bright_cyan"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "bright_magenta"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "bright_blue"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "bright_cyan"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "bright_magenta"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "bright_red"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "bright_magenta"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "bright_blue"
    },
    {
      "type": "disk",
      "key": "Storage",
      "keyColor": "bright_cyan"
    }
  ]
}